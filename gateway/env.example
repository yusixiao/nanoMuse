# Self-hosted nanoMuse gateway stack: an OpenAI-compatible relay to Vertex
# Gemini plus (optionally) a telegram-mcp sidecar, fronted by Caddy for TLS.
#
#   deploy/
#   ├── Caddyfile          copy to the box; edit the site address to your name
#   ├── docker-compose.yml
#   ├── env.example        cp to .env and fill in; .env is git-ignored
#   └── sa/                GCP service-account JSON here (git-ignored)
#
# The phone points at https://<your-host> as its relay (NanoMuseCloud
# base URL) with GATEWAY_TOKEN as the API key.

# --- gateway ---
# Project from the SA file if unset. Model must exist on Vertex.
GATEWAY_PROJECT=
GATEWAY_MODEL=gemini-3.8-flash
# The key the phone sends as `Authorization: Bearer …`
GATEWAY_TOKEN=

# --- telegram-mcp (optional; leave TG_API_ID empty to skip the container) ---
# From https://my.telegram.org → API development tools.
TG_API_ID=
TG_API_HASH=
# Session string via the repo's session_string_generator.py (QR or phone login).
TG_SESSION=
# Optional chat-id allow-list (comma separated). Empty = the whole account.
TG_ALLOWED_CHAT_IDS=
TG_EXPOSED_TOOLS=all
# Bearer the phone must send to reach /mcp through Caddy. Generate one.
TG_PROXY_TOKEN=
# Host names Caddy may forward (comma separated) — the DNS-rebinding guard.
MCP_ALLOWED_HOSTS=localhost
